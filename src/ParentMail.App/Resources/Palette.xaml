<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 色は docs/plans/mockups/main-window.html と一致させる。色だけに頼らず文字・太字を併用する。 -->
    <SolidColorBrush x:Key="Page" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PageText" Color="#000000" />
    <SolidColorBrush x:Key="BannerOffline" Color="#FFD54F" />
    <SolidColorBrush x:Key="BannerOfflineText" Color="#000000" />
    <SolidColorBrush x:Key="BannerError" Color="#A80000" />
    <SolidColorBrush x:Key="BannerErrorText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BannerLoading" Color="#CFE8FF" />
    <SolidColorBrush x:Key="BannerLoadingText" Color="#000000" />
    <SolidColorBrush x:Key="Badge" Color="#A80000" />
    <SolidColorBrush x:Key="BadgeText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NoticeOk" Color="#1B5E20" />
    <SolidColorBrush x:Key="NoticeOkText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Primary" Color="#0B4FA8" />
    <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryActiveBorder" Color="#06306B" />
    <SolidColorBrush x:Key="Button" Color="#E8E8E8" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#767676" />
    <SolidColorBrush x:Key="ButtonText" Color="#000000" />
    <SolidColorBrush x:Key="RowSelected" Color="#D6E4F7" />
    <SolidColorBrush x:Key="DateText" Color="#333333" />
    <SolidColorBrush x:Key="Hint" Color="#595959" />
    <SolidColorBrush x:Key="DeleteOutline" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DeleteOutlineText" Color="#A80000" />
    <SolidColorBrush x:Key="Focus" Color="#0B4FA8" />
    <SolidColorBrush x:Key="FocusOnDark" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bar" Color="#F3F3F3" />
    <SolidColorBrush x:Key="BarBorder" Color="#999999" />

    <!-- 見えるフォーカス枠（3 px）。暗いボタンの上では白にする。 -->
    <Style x:Key="AppFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" StrokeThickness="3" Stroke="{DynamicResource Focus}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AppFocusVisualOnDark">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" StrokeThickness="3" Stroke="{DynamicResource FocusOnDark}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 通常ボタン。高さ 56 DIP 以上、幅 120 DIP 以上、余白 24。 -->
    <Style x:Key="AppButton" TargetType="Button">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="24,8" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Button}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Hint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="Background" Value="{DynamicResource Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualOnDark}" />
    </Style>

    <!-- 選択中のフォルダボタン（押された見た目: 太い枠 + 青地）。 -->
    <Style x:Key="ActiveFolderButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BorderThickness" Value="4" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActiveBorder}" />
    </Style>

    <Style x:Key="DeleteOutlineButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="Background" Value="{DynamicResource DeleteOutline}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DeleteOutlineText}" />
        <Setter Property="Foreground" Value="{DynamicResource DeleteOutlineText}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- 帯の中の操作ボタン・閉じるボタン（48 DIP 以上）。 -->
    <Style x:Key="BannerButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="Padding" Value="16,4" />
    </Style>

    <!-- 赤い丸（未読数・送信失敗数）。 -->
    <Style x:Key="BadgePill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Badge}" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>

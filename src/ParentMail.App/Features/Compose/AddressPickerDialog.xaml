<Window x:Class="ParentMail.App.Features.Compose.AddressPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParentMail.App.Features.Compose"
        Width="720" Height="560" Background="{DynamicResource Page}" Foreground="{DynamicResource PageText}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 説明 [CP-19] -->
        <TextBlock Grid.Row="0" Text="{Binding HintText}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <!-- 1 行 = 1 つのメールアドレス。Tab では一覧の中に入らず、矢印で動き、Space か押して切り替える -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="2">
            <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectionMode="Single"
                     KeyboardNavigation.TabNavigation="Once" HorizontalContentAlignment="Stretch"
                     BorderThickness="0" Background="{DynamicResource Page}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewKeyDown="OnListKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="MinHeight" Value="56" />
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRowClick" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" MinWidth="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 見た目だけ。切り替えは行ごとに処理する -->
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=OneWay}" IsEnabled="{Binding IsEnabled}"
                                      IsHitTestVisible="False" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                      Margin="0,0,16,0">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"
                                       Margin="0,0,16,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Address}" Foreground="{DynamicResource Hint}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding TagText}" Foreground="{DynamicResource Hint}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- エラー行 [CP-20] -->
        <TextBlock Grid.Row="2" Text="{Binding ErrorText}" Foreground="{DynamicResource BannerError}" FontWeight="Bold"
                   TextWrapping="Wrap" MinHeight="32" Margin="0,12,0,12" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}"
                    Content="{x:Static local:ComposeText.PickerConfirm}" Click="OnConfirm" />
            <Button x:Name="CancelButton" Style="{StaticResource AppButton}" Margin="16,0,0,0"
                    Content="{x:Static local:ComposeText.PickerCancel}" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>

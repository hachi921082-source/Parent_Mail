<Window x:Class="ParentMail.App.Features.FilterRules.FilterRuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParentMail.App.Features.FilterRules"
        Width="820" SizeToContent="Height" Background="{DynamicResource Page}"
        Foreground="{DynamicResource PageText}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 案内: 条件をすべて満たすメールに使います -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static local:FilterText.EditHint}"
                       Foreground="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static local:FilterText.LabelSender}"
                       VerticalAlignment="Center" Margin="0,0,16,12" />
            <TextBox x:Name="SenderBox" Grid.Row="1" Grid.Column="1"
                     Text="{Binding SenderContains, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="6,4" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static local:FilterText.LabelSubject}"
                       VerticalAlignment="Center" Margin="0,0,16,12" />
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding SubjectContains, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="6,4" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static local:FilterText.LabelBody}"
                       VerticalAlignment="Center" Margin="0,0,16,12" />
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding BodyContains, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="6,4" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static local:FilterText.LabelAction}"
                       VerticalAlignment="Center" Margin="0,0,16,12" />
            <ComboBox x:Name="ActionBox" Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Choices}"
                      SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Text" Margin="0,0,0,12" Padding="6,4" />

            <!-- エラー行（その場に表示。保存ボタンは常に押せる） -->
            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ErrorText}"
                       Foreground="{DynamicResource BannerError}" FontWeight="Bold" TextWrapping="Wrap"
                       MinHeight="32" Margin="0,0,0,12" />

            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}"
                        Content="{x:Static local:FilterText.BtnSave}" Click="OnSave" />
                <Button x:Name="CancelButton" Style="{StaticResource AppButton}" Margin="16,0,0,0"
                        Content="{x:Static local:FilterText.BtnCancel}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>

<Window x:Class="ParentMail.App.Features.FilterRules.FilterRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParentMail.App.Features.FilterRules"
        Width="900" Height="600" Background="{DynamicResource Page}"
        Foreground="{DynamicResource PageText}" Title="{Binding Title}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView x:Name="List" Grid.Row="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  SelectionMode="Single" PreviewKeyDown="OnListKeyDown" MouseDoubleClick="OnListDoubleClick"
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="4,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Foreground" Value="{DynamicResource PageText}" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RowSelected}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{x:Static local:FilterText.ColEnabled}" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Tab では止まらず、Space は一覧が受けて切り替える。クリックでも切り替わる -->
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Focusable="False"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{x:Static local:FilterText.ColDescription}" Width="570">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{x:Static local:FilterText.ColAction}" Width="190"
                                    DisplayMemberBinding="{Binding ActionText}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 0 件のときの案内 -->
        <TextBlock Grid.Row="0" Text="{x:Static local:FilterText.EmptyList}" Foreground="{DynamicResource Hint}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource AppButton}" Content="{x:Static local:FilterText.BtnAdd}"
                        Command="{Binding AddCommand}" />
                <Button Style="{StaticResource AppButton}" Content="{x:Static local:FilterText.BtnEdit}"
                        Command="{Binding EditCommand}" Margin="12,0,0,0" />
                <Button Style="{StaticResource AppButton}" Content="{x:Static local:FilterText.BtnDelete}"
                        Command="{Binding DeleteCommand}" Margin="12,0,0,0" />
                <Button Style="{StaticResource AppButton}" Content="{x:Static local:FilterText.BtnUp}"
                        Command="{Binding MoveUpCommand}" Margin="12,0,0,0" />
                <Button Style="{StaticResource AppButton}" Content="{x:Static local:FilterText.BtnDown}"
                        Command="{Binding MoveDownCommand}" Margin="12,0,0,0" />
            </StackPanel>
            <Button x:Name="CloseButton" Style="{StaticResource AppButton}" HorizontalAlignment="Right"
                    Content="{x:Static local:FilterText.BtnClose}" />
        </Grid>
    </Grid>
</Window>

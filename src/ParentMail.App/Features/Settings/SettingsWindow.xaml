<Window x:Class="ParentMail.App.Features.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="720" SizeToContent="Height"
        FontSize="{Binding AppFontSize}"
        Background="{DynamicResource Page}" Foreground="{DynamicResource PageText}"
        UseLayoutRounding="True">
    <!-- 上から: 文字の大きさ（数字欄・pt・スライダー・範囲）、見本、アカウント欄、閉じる。タブ順もこの順。 -->
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Content="{Binding CloseLabel}" Click="OnClose"
                    Style="{StaticResource PrimaryButton}" TabIndex="100" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" IsTabStop="False">
            <StackPanel>
                <TextBlock Text="{Binding TextSizeLabel}" FontWeight="Bold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SizeBox" Grid.Column="0" Width="96" MinHeight="48" Padding="6,4"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             Text="{Binding TextSizeText, UpdateSourceTrigger=LostFocus}" TabIndex="0" />
                    <TextBlock Grid.Column="1" Text="{Binding UnitLabel}" VerticalAlignment="Center" Margin="8,0,16,0" />
                    <Slider x:Name="SizeSlider" Grid.Column="2" VerticalAlignment="Center" MinHeight="48"
                            Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                            TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4"
                            Value="{Binding TextSizePt, Mode=TwoWay}"
                            AutomationProperties.Name="{Binding SliderName}" TabIndex="1" />
                    <TextBlock Grid.Column="3" Text="{Binding RangeHint}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Badge}" FontWeight="Bold"
                           TextWrapping="Wrap" MinHeight="32" Margin="0,8,0,8" />

                <Border BorderBrush="{DynamicResource PageText}" BorderThickness="1" Padding="16" Margin="0,0,0,24">
                    <TextBlock Text="{Binding SampleText}" TextWrapping="Wrap" />
                </Border>

                <!-- アカウント欄は accounts-auth の部品を差し込む（コードビハインドで Content を入れる） -->
                <ContentControl x:Name="AccountSection" IsTabStop="False" KeyboardNavigation.TabNavigation="Continue" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="ParentMail.App.Features.AccountsAuth.ReenterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="680" SizeToContent="Height"
        Background="{DynamicResource Page}" Foreground="{DynamicResource PageText}"
        UseLayoutRounding="True">
    <!-- 上から: アカウント名とアドレス、パスワード欄、赤いエラー行、ボタン。タブ順もこの順。 -->
    <StackPanel Margin="24">
        <TextBlock Text="{Binding AccountText}" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,16" />

        <TextBlock Text="{Binding PasswordLabel}" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordInput" IsEnabled="{Binding FieldsEnabled}" MinHeight="48" Padding="6,4"
                     VerticalContentAlignment="Center" Margin="0,0,0,12" TabIndex="0" />

        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Badge}" FontWeight="Bold"
                   TextWrapping="Wrap" MinHeight="32" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}" TabIndex="1" Margin="0,0,16,0" />
            <Button x:Name="CancelButton" Content="{Binding CancelLabel}" Style="{StaticResource AppButton}"
                    IsEnabled="{Binding FieldsEnabled}" TabIndex="2" />
        </StackPanel>
    </StackPanel>
</Window>

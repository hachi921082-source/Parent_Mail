<UserControl x:Class="ParentMail.App.Features.AccountsAuth.AccountStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ParentMail.App.Resources"
             xmlns:core="clr-namespace:ParentMail.Core;assembly=ParentMail.Core"
             IsTabStop="False" Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 左右の矢印。使えない（端まで来た）ときは灰色の枠と文字 -->
        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="Width" Value="{x:Static core:Constants.AccountScrollArrowDip}" />
            <Setter Property="Height" Value="{x:Static core:Constants.AccountScrollArrowDip}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource Hint}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左の矢印（はみ出しているときだけ表示） -->
        <Grid x:Name="LeftArrowHost" Grid.Column="0" Visibility="Collapsed" Margin="0,0,12,0" VerticalAlignment="Center">
            <Button x:Name="LeftArrow" Content="&#x25C0;" Style="{StaticResource ArrowButton}" Click="OnLeftArrow" />
            <Border x:Name="LeftBadge" Style="{StaticResource BadgePill}" Visibility="Collapsed" Margin="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                <TextBlock x:Name="LeftBadgeText" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource BadgeText}" />
            </Border>
        </Grid>

        <!-- ボタン帯。スクロールバーは出さない（矢印とホイールで動かす） -->
        <ScrollViewer x:Name="Scroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      IsTabStop="False" Focusable="False" CanContentScroll="False" PanningMode="None"
                      PreviewMouseWheel="OnWheel" ScrollChanged="OnScrollChanged" SizeChanged="OnScrollerSizeChanged">
            <ItemsControl x:Name="Host" IsTabStop="False" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 右に 16 DIP の間隔を取る。フォーカス枠はボタンの内側に描くので端でも切れない -->
                        <Button Command="{Binding SelectCommand}" ToolTip="{Binding ToolTip}"
                                MinWidth="{x:Static core:Constants.AccountButtonMinWidthDip}"
                                MaxWidth="{Binding ButtonMaxWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Padding="16,8" Margin="0,4,16,4"
                                AutomationProperties.Name="{Binding Name}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AppButton}">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Primary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActiveBorder}" />
                                            <Setter Property="BorderThickness" Value="4" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualOnDark}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#x2713;" Margin="0,0,8,0" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- 非選択側だけ。名前が長くても先にバッジ分（約 50 DIP）を確保する -->
                                <Border Grid.Column="2" Style="{StaticResource BadgePill}"
                                        Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding BadgeText}" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BadgeText}" />
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 右の矢印 -->
        <Grid x:Name="RightArrowHost" Grid.Column="2" Visibility="Collapsed" Margin="4,0,12,0" VerticalAlignment="Center">
            <Button x:Name="RightArrow" Content="&#x25B6;" Style="{StaticResource ArrowButton}" Click="OnRightArrow" />
            <Border x:Name="RightBadge" Style="{StaticResource BadgePill}" Visibility="Collapsed" Margin="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                <TextBlock x:Name="RightBadgeText" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource BadgeText}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>

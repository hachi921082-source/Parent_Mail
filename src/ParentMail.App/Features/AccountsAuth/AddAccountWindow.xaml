<Window x:Class="ParentMail.App.Features.AccountsAuth.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ParentMail.App.Resources"
        Title="{x:Static res:Strings.WD_03}" Width="680" SizeToContent="Height"
        Background="{DynamicResource Page}" Foreground="{DynamicResource PageText}"
        UseLayoutRounding="True">
    <!-- 上から: 案内、メールアドレス、アプリパスワード、表示名、赤いエラー行、ボタン。タブ順もこの順。 -->
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,16" />

        <TextBlock Text="{Binding EmailLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding FieldsEnabled}" MinHeight="48" Padding="6,4" VerticalContentAlignment="Center"
                 Margin="0,0,0,12" TabIndex="0" />

        <TextBlock Text="{Binding PasswordLabel}" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordInput" IsEnabled="{Binding FieldsEnabled}" MinHeight="48" Padding="6,4"
                     VerticalContentAlignment="Center" Margin="0,0,0,12" TabIndex="1" />

        <TextBlock Text="{Binding NameLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding FieldsEnabled}" MinHeight="48" Padding="6,4" VerticalContentAlignment="Center"
                 Margin="0,0,0,12" TabIndex="2" />

        <!-- 赤いエラー行（その場に出す）。空のときも 1 行分の高さを確保して、出たり消えたりで窓が揺れないようにする。 -->
        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Badge}" FontWeight="Bold"
                   TextWrapping="Wrap" MinHeight="32" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SubmitButton" Content="{Binding SubmitLabel}" Command="{Binding SubmitCommand}"
                    Style="{StaticResource PrimaryButton}" TabIndex="3" Margin="0,0,16,0" />
            <Button x:Name="CancelButton" Content="{Binding CancelLabel}" Style="{StaticResource AppButton}"
                    IsEnabled="{Binding FieldsEnabled}" TabIndex="4" />
        </StackPanel>
    </StackPanel>
</Window>

<UserControl x:Class="ParentMail.App.Features.Search.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ParentMail.App.Resources">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- 一覧ペイン上部の検索ボックス。常に表示する。 -->
    <Border Background="{DynamicResource Bar}" BorderBrush="{DynamicResource BarBorder}" BorderThickness="0,0,0,1" Padding="6">
        <StackPanel>
            <Grid>
                <TextBox x:Name="QueryBox" MinHeight="48" VerticalContentAlignment="Center" Padding="6,4"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static res:Strings.SR_03}"
                         KeyDown="OnQueryKeyDown" />
                <!-- 入力が空のときだけ見える案内文 -->
                <TextBlock Text="{x:Static res:Strings.SR_03}" Foreground="{DynamicResource Hint}" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="10,0,6,0" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <UniformGrid Columns="2" Margin="0,6,0,0">
                <Button Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" MinWidth="0" MinHeight="48"
                        Margin="0,0,3,0" Content="{x:Static res:Strings.SR_01}" />
                <Button Command="{Binding ClearCommand}" Style="{StaticResource AppButton}" MinWidth="0" MinHeight="48"
                        Margin="3,0,0,0" Content="{x:Static res:Strings.SR_02}" />
            </UniformGrid>
            <!-- 結果の表示中に出す固定の注意書き（Q30） -->
            <TextBlock Text="{x:Static res:Strings.SR_05}" TextWrapping="Wrap" Margin="2,8,2,0"
                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{x:Static res:Strings.SR_06}" TextWrapping="Wrap" FontWeight="Bold" Margin="2,6,2,0"
                       Visibility="{Binding ShowTruncated, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{x:Static res:Strings.SR_07}" TextWrapping="Wrap" FontWeight="Bold" Margin="2,6,2,0"
                       Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>

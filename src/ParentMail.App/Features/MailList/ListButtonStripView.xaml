<UserControl x:Class="ParentMail.App.Features.MailList.ListButtonStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ParentMail.App.Resources">
    <UserControl.Resources>
        <!-- 帯のボタン。長い文字は折り返す（受信拒否リストなど）。 -->
        <Style x:Key="StripText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <!-- 文字は上部バーと同じく 20 pt で頭打ち -->
    <Border Background="{DynamicResource Bar}" BorderBrush="{DynamicResource BarBorder}" BorderThickness="0,2,0,0" Padding="6"
            TextElement.FontSize="{Binding ChromeFontSize}">
        <UniformGrid Columns="2" Rows="3">
            <Button Command="{Binding ComposeCommand}" Style="{StaticResource PrimaryButton}" Margin="4" MinWidth="0" Padding="8,6">
                <TextBlock Text="{x:Static res:Strings.TB_14}" Style="{StaticResource StripText}" />
            </Button>
            <Button Command="{Binding SearchCommand}" Style="{StaticResource AppButton}" Margin="4" MinWidth="0" Padding="8,6">
                <TextBlock Text="{x:Static res:Strings.TB_15}" Style="{StaticResource StripText}" />
            </Button>
            <Button Command="{Binding SettingsCommand}" Style="{StaticResource AppButton}" Margin="4" MinWidth="0" Padding="8,6">
                <TextBlock Text="{x:Static res:Strings.TB_16}" Style="{StaticResource StripText}" />
            </Button>
            <Button Command="{Binding AddressBookCommand}" Style="{StaticResource AppButton}" Margin="4" MinWidth="0" Padding="8,6">
                <TextBlock Text="{x:Static res:Strings.TB_17}" Style="{StaticResource StripText}" />
            </Button>
            <Button Command="{Binding BlockListCommand}" Style="{StaticResource AppButton}" Margin="4" MinWidth="0" Padding="8,6">
                <TextBlock Text="{x:Static res:Strings.TB_18}" Style="{StaticResource StripText}" />
            </Button>
            <Button Command="{Binding FilterRulesCommand}" Style="{StaticResource AppButton}" Margin="4" MinWidth="0" Padding="8,6">
                <TextBlock Text="{x:Static res:Strings.TB_19}" Style="{StaticResource StripText}" />
            </Button>
        </UniformGrid>
    </Border>
</UserControl>

<UserControl x:Class="ParentMail.App.Features.MailList.ListButtonStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ParentMail.App.Resources">
    <UserControl.Resources>
        <!-- 帯のボタン。長い文字は折り返す（受信拒否リストなど）。 -->
        <Style x:Key="StripText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <!-- 文字は上部バーと同じく 20 pt で頭打ち -->
    <Border Background="{DynamicResource Bar}" BorderBrush="{DynamicResource BarBorder}" BorderThickness="0,2,0,0" Padding="6"
            TextElement.FontSize="{Binding ChromeFontSize}">
        <!-- 2 列 x 3 行。1 行目の右（行 0・列 1）は空きマスで、コントロールを置かない（Q88） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Command="{Binding ComposeCommand}" Style="{StaticResource PrimaryButton}" Margin="4" MinWidth="0" Padding="8,6">
                <TextBlock Text="{x:Static res:Strings.TB_14}" Style="{StaticResource StripText}" />
            </Button>
            <Button Grid.Row="1" Grid.Column="0" Command="{Binding SettingsCommand}" Style="{StaticResource AppButton}" Margin="4" MinWidth="0" Padding="8,6">
                <TextBlock Text="{x:Static res:Strings.TB_16}" Style="{StaticResource StripText}" />
            </Button>
            <Button Grid.Row="1" Grid.Column="1" Command="{Binding AddressBookCommand}" Style="{StaticResource AppButton}" Margin="4" MinWidth="0" Padding="8,6">
                <TextBlock Text="{x:Static res:Strings.TB_17}" Style="{StaticResource StripText}" />
            </Button>
            <Button Grid.Row="2" Grid.Column="0" Command="{Binding BlockListCommand}" Style="{StaticResource AppButton}" Margin="4" MinWidth="0" Padding="8,6">
                <TextBlock Text="{x:Static res:Strings.TB_18}" Style="{StaticResource StripText}" />
            </Button>
            <Button Grid.Row="2" Grid.Column="1" Command="{Binding FilterRulesCommand}" Style="{StaticResource AppButton}" Margin="4" MinWidth="0" Padding="8,6">
                <TextBlock Text="{x:Static res:Strings.TB_19}" Style="{StaticResource StripText}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
